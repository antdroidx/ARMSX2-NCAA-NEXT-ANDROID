    The quadword mask and the shift to bytes are a single UBFIZ.
    Idea from @pstef

diff --git a/pcsx2/arm64/microVU_Misc-arm64.inl b/pcsx2/arm64/microVU_Misc-arm64.inl
index 6dfc2a4f27..40f827fba7 100644
--- a/pcsx2/arm64/microVU_Misc-arm64.inl
+++ b/pcsx2/arm64/microVU_Misc-arm64.inl
@@ -321,8 +321,7 @@ __fi void mVUaddrFix(mV, const a64::Register& gprReg)
 	if (isVU1)
 	{
 		// VU1: mask to 0x3FF quadwords, shift left 4 (x16 bytes)
-		armAsm->And(gprReg.W(), gprReg.W(), 0x3ff);
-		armAsm->Lsl(gprReg.W(), gprReg.W(), 4);
+		armAsm->Ubfiz(gprReg.W(), gprReg.W(), 4, 10);
 	}
 	else
 	{
